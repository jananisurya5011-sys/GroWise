rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. CHATS: Strictly authorized by participants with separated CRUD
    match /chats/{chatId} {
      allow read: if request.auth != null && (
        resource.data.userEmail == request.auth.uid || 
        resource.data.farmerEmail == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.userEmail == request.auth.uid || 
        request.resource.data.farmerEmail == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.userEmail == request.auth.uid || 
        resource.data.farmerEmail == request.auth.uid
      ) && (
        request.resource.data.userEmail == resource.data.userEmail &&
        request.resource.data.farmerEmail == resource.data.farmerEmail
      );
      allow delete: if request.auth != null && (
        resource.data.userEmail == request.auth.uid || 
        resource.data.farmerEmail == request.auth.uid
      );
    }

    // 2. MESSAGES: Authorized by parent chat document
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null && (
        get(/databases/$(database)/documents/chats/$(chatId)).data.userEmail == request.auth.uid ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.farmerEmail == request.auth.uid
      );
    }

    // 3. USERS: Globally readable by authenticated users (needed for search), writable by owner
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. SHARED COLLECTIONS: Global Authenticated Access
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    match /wallets/{walletId} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{txId} {
      allow read, write: if request.auth != null;
    }
    match /inventory/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
